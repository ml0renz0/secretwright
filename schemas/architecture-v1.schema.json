{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:secretwright:architecture:v1",
  "title": "Secretwright architecture manifest v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "const": "secretwright/architecture/v1"
    },
    "name": {
      "$ref": "#/$defs/label"
    },
    "instances": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/label"
              },
              "template": {
                "const": "single-user"
              },
              "mount": {
                "$ref": "#/$defs/mount"
              },
              "access": {
                "enum": [
                  "read",
                  "read-write"
                ],
                "default": "read"
              },
              "users": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/label"
                }
              }
            },
            "required": [
              "id",
              "template",
              "mount",
              "users"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/label"
              },
              "template": {
                "const": "multi-user"
              },
              "mount": {
                "$ref": "#/$defs/mount"
              },
              "access": {
                "enum": [
                  "read",
                  "read-write"
                ],
                "default": "read"
              },
              "users": {
                "type": "array",
                "minItems": 2,
                "maxItems": 8,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/label"
                }
              }
            },
            "required": [
              "id",
              "template",
              "mount",
              "users"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/label"
              },
              "template": {
                "const": "single-app"
              },
              "mount": {
                "$ref": "#/$defs/mount"
              },
              "access": {
                "enum": [
                  "read",
                  "read-write"
                ],
                "default": "read"
              },
              "auth_mount": {
                "$ref": "#/$defs/mount",
                "default": "approle"
              },
              "applications": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/label"
                }
              }
            },
            "required": [
              "id",
              "template",
              "mount",
              "applications"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/label"
              },
              "template": {
                "const": "multi-app"
              },
              "mount": {
                "$ref": "#/$defs/mount"
              },
              "access": {
                "enum": [
                  "read",
                  "read-write"
                ],
                "default": "read"
              },
              "auth_mount": {
                "$ref": "#/$defs/mount",
                "default": "approle"
              },
              "applications": {
                "type": "array",
                "minItems": 2,
                "maxItems": 8,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/label"
                }
              }
            },
            "required": [
              "id",
              "template",
              "mount",
              "applications"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/label"
              },
              "template": {
                "const": "multi-env"
              },
              "mount": {
                "$ref": "#/$defs/mount"
              },
              "access": {
                "enum": [
                  "read",
                  "read-write"
                ],
                "default": "read"
              },
              "auth_mount": {
                "$ref": "#/$defs/mount",
                "default": "approle"
              },
              "applications": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/label"
                }
              },
              "environments": {
                "type": "array",
                "minItems": 2,
                "maxItems": 8,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/label"
                }
              }
            },
            "required": [
              "id",
              "template",
              "mount",
              "applications",
              "environments"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/label"
              },
              "template": {
                "const": "saas"
              },
              "mount": {
                "$ref": "#/$defs/mount"
              },
              "access": {
                "enum": [
                  "read",
                  "read-write"
                ],
                "default": "read"
              },
              "auth_mount": {
                "$ref": "#/$defs/mount",
                "default": "approle"
              },
              "applications": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/label"
                }
              },
              "environments": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/label"
                }
              },
              "tenants": {
                "type": "array",
                "minItems": 2,
                "maxItems": 8,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/label"
                }
              }
            },
            "required": [
              "id",
              "template",
              "mount",
              "applications",
              "environments",
              "tenants"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "api_version",
    "name",
    "instances"
  ],
  "$defs": {
    "label": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,23}$"
    },
    "mount": {
      "type": "string",
      "maxLength": 1024,
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}(/[a-z0-9][a-z0-9_.-]{0,127})*$"
    }
  }
}
